# 이 파일을 .env 로 복사해 값을 바꾼다. (.env 는 git에 올리지 않는다)
# 결함 프로필: none | beginner | intermediate | advanced
DEFECT_PROFILE=none
# 프로필 위에 개별 결함을 더하거나 뺀다 (쉼표 목록, 비워 두면 사용 안 함)
DEFECTS_ON=
DEFECTS_OFF=
# 호스트 포트 (모두 127.0.0.1 에만 바인딩된다)
WEB_PORT=8080
API_PORT=3000
DB_PORT=55432
# 환경 조건 (결함이 아님). 웹 화면 DOM 변형: v1 | v2 / API 응답 지연: none | slow | unstable
# 테스트에서는 요청 헤더 X-QA-Lab-UI-Variant, X-QA-Lab-Latency 로 그 요청만 바꿀 수 있다.
UI_VARIANT=v1
LATENCY_PROFILE=none
