{
  "name": "qa-lab-practice",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "dockerDashComposeVersion": "latest"
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "postCreateCommand": "npm ci && npx playwright install --with-deps chromium",
  "forwardPorts": [8080, 3000],
  "portsAttributes": {
    "8080": { "label": "QA 숍 웹", "onAutoForward": "notify" },
    "3000": { "label": "QA 숍 API·Swagger UI", "onAutoForward": "silent" },
    "55432": { "label": "DB (전달하지 않음)", "onAutoForward": "ignore" }
  },
  "otherPortsAttributes": { "onAutoForward": "ignore" },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
